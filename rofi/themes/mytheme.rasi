* {
    bg:         #111111;
    bg-alt:     #1a1a1a;

    fg:         #ffffff;
    selected:   #ffffff;
    prompt-col: #cba6f7;

    background-color: transparent;
    text-color: @fg;

    font: "JetBrainsMono Nerd Font 12";
}

window {
    width: 40%;
    border: 2px;
    border-color: rgba(255,255,255,0.20);
    border-radius: 16px;

    background-color: rgba(17,17,17,0.60);
}

mainbox {
    padding: 12px;
    background-color: transparent;
}

inputbar {
    background-color: rgba(0,0,0,0.45);
    border-radius: 12px;
    padding: 10px;
    margin: 0px 0px 12px 0px;
}

prompt {
    text-color: @prompt-col;
    margin: 0px 8px 0px 0px;
}

entry {
    placeholder: "Search...";
    text-color: #ffffff;
}

listview {
    lines: 8;
    spacing: 8px;
    scrollbar: false;
    background-color: transparent;
}

element {
    padding: 10px;
    border-radius: 12px;

    background-color: rgba(0,0,0,0.35);
    text-color: #ffffff;
}

element selected {
    background-color: rgba(255,255,255,0.18);
    text-color: #ffffff;
}

element-icon {
    size: 24px;
    margin: 0px 10px 0px 0px;
    background-color: transparent;
}
