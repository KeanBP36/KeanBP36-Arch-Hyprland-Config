{
  "layer": "top",
  "position": "top",
  "height": 28,

  "modules-left": [
    "hyprland/workspaces"
  ],

  "modules-center": [
    "clock"
  ],

  "modules-right": [
    "custom/cpu",
    "custom/gpu",
    "memory",
    "tray"
  ],

  "clock": {
    "format": "{:%H:%M | %d-%m-%Y}"
  },

  "memory": {
    "interval": 2,
    "format": "RAM {percentage}%"
  },

  "custom/cpu": {
    "exec": "~/.config/waybar/scripts/cpu.sh",
    "interval": 2
  },

  "custom/gpu": {
    "exec": "~/.config/waybar/scripts/gpu.sh",
    "interval": 2
  }
}
